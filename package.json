{
  "name": "mosslight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/check-testflight.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-mono": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.56.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
